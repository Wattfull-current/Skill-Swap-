generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int            @id @default(autoincrement())
  email             String         @unique
  name              String
  role              String         // student | individual | enterprise
  password          String?
  gender            String?        // male | female | non-binary | prefer-not-to-say
  dateOfBirth       DateTime?
  nationality       String?
  phone             String?
  credits           Int            @default(100)

  // Student specific
  institutionalId   String?
  className         String?
  fieldOfStudy      String?
  institution       String?

  // Enterprise specific
  enterpriseName    String?
  enterpriseRole    String?
  enterpriseCountry String?

  // Idea
  hasIdea           Boolean        @default(false)
  ideaDescription   String?

  // Privacy settings (JSON string: { fieldName: 'public' | 'private' })
  privacySettings   String?

  // Relations
  skills            Skill[]
  interests         Interest[]
  education         Education[]
  projects          Project[]
  sentRequests      Connection[]   @relation("Sender")
  receivedRequests  Connection[]   @relation("Receiver")
  notifications     Notification[]
  sentMessages      Message[]      @relation("SentBy")
  receivedMessages  Message[]      @relation("ReceivedBy")
  createdAt         DateTime       @default(now())
}

model Skill {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  userId      Int
  user        User         @relation(fields: [userId], references: [id])
  certificate Certificate?
}

model Certificate {
  id         Int      @id @default(autoincrement())
  fileName   String
  mimeType   String
  fileData   String   // base64 encoded file content
  skillId    Int      @unique
  skill      Skill    @relation(fields: [skillId], references: [id])
  uploadedAt DateTime @default(now())
}

model Interest {
  id     Int    @id @default(autoincrement())
  name   String
  userId Int
  user   User   @relation(fields: [userId], references: [id])
}

model Education {
  id          Int      @id @default(autoincrement())
  institution String
  degree      String?
  field       String?
  status      String   // completed | attending
  startYear   Int
  endYear     Int?
  expectedEnd Int?
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}

model Connection {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  status     String   @default("pending") // pending | accepted | rejected
  sender     User     @relation("Sender",   fields: [senderId],   references: [id])
  receiver   User     @relation("Receiver", fields: [receiverId], references: [id])
  createdAt  DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      String   // connection_request | message | system
  message   String
  isRead    Boolean  @default(false)
  metadata  String?  // JSON string for extra data (senderId, etc.)
  createdAt DateTime @default(now())
}

model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  content    String
  isRead     Boolean  @default(false)
  sender     User     @relation("SentBy",     fields: [senderId],   references: [id])
  receiver   User     @relation("ReceivedBy", fields: [receiverId], references: [id])
  createdAt  DateTime @default(now())
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model Transaction {
  id         Int      @id @default(autoincrement())
  amount     Int
  senderId   Int
  receiverId Int
  createdAt  DateTime @default(now())
}